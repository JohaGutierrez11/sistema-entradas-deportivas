digraph ER {
  graph [rankdir=LR, splines=polyline, nodesep=0.5, ranksep=1.1, fontname="DejaVu Sans", bgcolor="white", pad=0.4,         label=<<B>Sistema de Gestión de Entradas — Modelo Entidad-Relación</B><BR/><FONT POINT-SIZE="11">Línea continua: FK real dentro del mismo microservicio · Línea punteada: referencia lógica entre microservicios (validada por REST)</FONT>>,         labelloc=t, fontsize=18];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#444444", dir=both, penwidth=1.2];
  subgraph cluster_0 { label=<<B>ms-usuarios</B>  ·  auth_db>; fontsize=14; style="rounded,filled"; fillcolor="#E8F0FE"; color="#999999";
    role [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>role</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">name <FONT COLOR="#666666">varchar(30)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · ADMIN | CLIENTE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">description <FONT COLOR="#666666">varchar(150)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">status <FONT COLOR="#666666">varchar(10)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · ACTIVO | INACTIVO</FONT></TD></TR></TABLE>>];
    app_user [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">username <FONT COLOR="#666666">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · generado al registrarse</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">password_hash <FONT COLOR="#666666">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · BCrypt</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">role_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">status <FONT COLOR="#666666">varchar(10)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · ACTIVO | INACTIVO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">must_change_password <FONT COLOR="#666666">boolean</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · contraseña de primer acceso</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">created_at <FONT COLOR="#666666">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">last_login_at <FONT COLOR="#666666">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR></TABLE>>];
    client [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>client</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">first_name <FONT COLOR="#666666">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">middle_name <FONT COLOR="#666666">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">last_name <FONT COLOR="#666666">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">cedula <FONT COLOR="#666666">varchar(10)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">nationality <FONT COLOR="#666666">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">address <FONT COLOR="#666666">varchar(200)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">phone <FONT COLOR="#666666">varchar(15)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">email <FONT COLOR="#666666">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FK, UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">user_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · relación 1 : 0..1</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_1 { label=<<B>ms-partidos</B>  ·  match_db>; fontsize=14; style="rounded,filled"; fillcolor="#E6F4EA"; color="#999999";
    stadium [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>stadium</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">name <FONT COLOR="#666666">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">description <FONT COLOR="#666666">varchar(250)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">location <FONT COLOR="#666666">varchar(200)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">total_capacity <FONT COLOR="#666666">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · CHECK &gt; 0</FONT></TD></TR></TABLE>>];
    section [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>section</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">stadium_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">name <FONT COLOR="#666666">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE(stadium_id, name)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">description <FONT COLOR="#666666">varchar(250)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">section_type <FONT COLOR="#666666">varchar(15)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · PALCOS | GENERAL | PREFERENCIA | TRIBUNAS</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">row_count <FONT COLOR="#666666">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · CHECK &gt; 0</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">seats_per_row <FONT COLOR="#666666">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · CHECK &gt; 0</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">capacity <FONT COLOR="#666666">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · CHECK = row_count * seats_per_row</FONT></TD></TR></TABLE>>];
    seat_row [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>seat_row</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">section_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">letter <FONT COLOR="#666666">varchar(2)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · A, B, C… · UNIQUE(section_id, letter)</FONT></TD></TR></TABLE>>];
    seat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>seat</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">seat_row_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">seat_number <FONT COLOR="#666666">int</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · CHECK &gt; 0 · UNIQUE(seat_row_id, seat_number)</FONT></TD></TR></TABLE>>];
    sport_match [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>sport_match</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">name <FONT COLOR="#666666">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">description <FONT COLOR="#666666">varchar(250)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">match_date <FONT COLOR="#666666">date</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">match_time <FONT COLOR="#666666">time</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">status <FONT COLOR="#666666">varchar(15)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · PROGRAMADO | EN_CURSO | FINALIZADO | CANCELADO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">stadium_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_2 { label=<<B>ms-reservas</B>  ·  reservation_db>; fontsize=14; style="rounded,filled"; fillcolor="#FEF3E2"; color="#999999";
    parameter [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>parameter</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">code <FONT COLOR="#666666">varchar(50)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · MAX_TICKETS_PER_MATCH, HOLD_MINUTES</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">value <FONT COLOR="#666666">varchar(100)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">description <FONT COLOR="#666666">varchar(250)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR></TABLE>>];
    reservation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>reservation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">code <FONT COLOR="#666666">varchar(20)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · identificador único de la reserva</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">client_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · referencia lógica a ms-usuarios</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">match_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · referencia lógica a ms-partidos</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">status <FONT COLOR="#666666">varchar(12)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · PENDIENTE | CONFIRMADA | CANCELADA | EXPIRADA</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">created_at <FONT COLOR="#666666">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">expires_at <FONT COLOR="#666666">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · created_at + HOLD_MINUTES</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">confirmed_at <FONT COLOR="#666666">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">cancelled_at <FONT COLOR="#666666">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR></TABLE>>];
    seat_lock [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>seat_lock</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">reservation_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">match_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · copia de reservation.match_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">seat_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · referencia lógica a ms-partidos</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">status <FONT COLOR="#666666">varchar(10)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · HELD | RESERVED</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF8C5"><FONT POINT-SIZE="9"><I>UNIQUE(match_id, seat_id) → impide doble venta</I></FONT></TD></TR></TABLE>>];
    ticket [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#1F3864"><FONT COLOR="white"><B>ticket</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>PK</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><U>id</U> <FONT COLOR="#666666">bigserial</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">reservation_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">seat_id <FONT COLOR="#666666">bigint</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · referencia lógica a ms-partidos</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UK</B></TD><TD ALIGN="LEFT" BGCOLOR="white">qr_code <FONT COLOR="#666666">varchar(64)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · token aleatorio, no secuencial</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">status <FONT COLOR="#666666">varchar(10)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · ACTIVO | UTILIZADO | ANULADO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">issued_at <FONT COLOR="#666666">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"> </TD><TD ALIGN="LEFT" BGCOLOR="white">used_at <FONT COLOR="#666666">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white"> </TD></TR></TABLE>>];
  }
